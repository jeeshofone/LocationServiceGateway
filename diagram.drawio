        <!-- Deployment -->
        <mxCell id="gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;your fork of this repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1">
