        </mxCell>
        <mxCell id="ss" value="Self-managed CloudFormation StackSet&lt;br&gt;one instance per region" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1">
          <mxGeometry x="900" y="658" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="boot" value="&lt;b&gt;Bootstrap, once per account&lt;/b&gt;&lt;br&gt;1. Deploy pipeline/pipeline.yaml. It creates the hosted zone, the GitHub connection, the StackSet roles, CodeBuild and CodePipeline.&lt;br&gt;2. Add the NameServers output as an NS record in the parent zone.&lt;br&gt;3. Approve the GitHub connection in the console." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D79B00;dashed=1;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
