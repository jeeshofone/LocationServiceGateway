<mxfile host="drawio" version="24.7.17">
  <diagram id="lsg" name="Location Service Gateway">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="840" background="#FFFFFF" math="0" shadow="0">
