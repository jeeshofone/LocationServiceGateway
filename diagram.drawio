          <mxGeometry x="470" y="658" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cb" value="CodeBuild: pipeline/buildspec.yaml&lt;br&gt;updates the StackSet, then&lt;br&gt;smoke-tests every region" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1">
